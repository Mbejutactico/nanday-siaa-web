<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <!-- Configuración al iniciar la aplicación (cookie de sesión) -->
    <listener>
        <listener-class>com.mycompany.proyectoprueba.seguridad.InicioAplicacion</listener-class>
    </listener>

    <!-- Seguridad: sesión obligatoria, permisos, CSRF y cierre de conexiones -->
    <filter>
        <filter-name>FiltroSeguridad</filter-name>
        <filter-class>com.mycompany.proyectoprueba.seguridad.FiltroSeguridad</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FiltroSeguridad</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Perfil: subida de la foto (multipart, máximo 2 MB) -->
    <servlet>
        <servlet-name>PerfilServlet</servlet-name>
        <servlet-class>com.mycompany.proyectoprueba.controlador.PerfilServlet</servlet-class>
        <multipart-config>
            <max-file-size>2097152</max-file-size>
            <max-request-size>3145728</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>PerfilServlet</servlet-name>
        <url-pattern>/PerfilServlet</url-pattern>
    </servlet-mapping>

    <!-- Controladores MVC (Servlet -> Servicio -> DAO), llamados por AJAX desde las pantallas -->
