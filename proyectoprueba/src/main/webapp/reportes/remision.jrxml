<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="remision" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e20130c4-e1fd-4c32-938c-e488bc87f5b2">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="ID_REMISION" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[Integer.valueOf(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="USUARIO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
    </parameter>
    <parameter name="FECHA" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <queryString>
		<![CDATA[SELECT
    r.numero_remision, r.tipo_remision, r.fecha_hora, r.anulada, r.motivo_anulacion, r.observacion,
    TRIM(COALESCE(r.transportista_nombre, '') || ' ' || COALESCE(r.transportista_apellido, '')) AS transportista,
    r.transportista_ci,
    NULLIF(TRIM(COALESCE(r.vehiculo_marca, '') || ' ' || COALESCE(r.vehiculo_modelo, '')), '') AS vehiculo,
    r.vehiculo_chapa,
    ue.nombre || ' ' || ue.apellido AS emitido_por,
    CASE r.tipo_remision
        WHEN 'SALIDA_INSUMOS' THEN 'OT ' || o.numero_ot || ' - ' || o.titulo
        WHEN 'TRANSFERENCIA' THEN 'Transferencia ' || t.numero
        WHEN 'SALIDA_ACTIVOS' THEN 'Solicitud ' || sa.numero || CASE sa.tipo WHEN 'REPARACION' THEN ' - Reparación'
                                                                    WHEN 'ENTREGA_OT' THEN ' - Entrega por OT ' || COALESCE(o.numero_ot, '')
                                                                    ELSE ' - Transferencia entre sucursales' END
        ELSE '' END AS referencia,
    CASE r.tipo_remision
        WHEN 'SALIDA_INSUMOS' THEN 'Centro: ' || COALESCE(c.nombre, '') || '  |  Centro de costo: ' || COALESCE(cc.codigo || ' - ' || cc.descripcion, cc.codigo, '')
                                   || '  |  Solicitante: ' || COALESCE(us.nombre || ' ' || us.apellido, '')
        WHEN 'TRANSFERENCIA' THEN 'Desde: ' || COALESCE(ao.nombre, '') || '  ->  Hacia: ' || COALESCE(ad.nombre, '')
        WHEN 'SALIDA_ACTIVOS' THEN CASE WHEN sa.tipo = 'REPARACION' THEN 'Proveedor (reparación): ' || COALESCE(pv.razon_social, '')
                                        ELSE 'Destino: ' || COALESCE(csa.nombre, '') || ' / ' || COALESCE(ccsa.codigo || ' - ' || ccsa.descripcion, ccsa.codigo, '') END
        ELSE '' END AS referencia_detalle,
    CASE r.tipo_remision
        WHEN 'SALIDA_INSUMOS' THEN 'Entrega de insumos por orden de trabajo'
        WHEN 'TRANSFERENCIA' THEN 'Traslado de insumos entre almacenes'
        WHEN 'SALIDA_ACTIVOS' THEN CASE sa.tipo WHEN 'REPARACION' THEN 'Envío de activos a reparación'
                                                WHEN 'ENTREGA_OT' THEN 'Entrega de activos por orden de trabajo'
                                                ELSE 'Traslado de activos entre sucursales' END
        ELSE '' END AS motivo_traslado,
    CASE r.tipo_remision
        WHEN 'SALIDA_INSUMOS' THEN (SELECT string_agg(DISTINCT a2.nombre || ' (' || COALESCE(c2.nombre, '') || ')', ', ')
                                      FROM detalle_ot d2 JOIN almacenes a2 ON a2.id_almacen = d2.id_almacen
                                      LEFT JOIN centros c2 ON c2.id_centro = a2.id_centro WHERE d2.id_remision = r.id_remision)
        WHEN 'TRANSFERENCIA' THEN ao.nombre || ' (' || COALESCE(cao.nombre, '') || ')'
        WHEN 'SALIDA_ACTIVOS' THEN (SELECT string_agg(DISTINCT c3.nombre, ', ') FROM solicitudes_activos_detalle d3
                                      JOIN centros c3 ON c3.id_centro = d3.id_centro_origen WHERE d3.id_solicitud = sa.id_solicitud)
        ELSE '' END AS partida,
    CASE r.tipo_remision
        WHEN 'SALIDA_INSUMOS' THEN (SELECT string_agg(DISTINCT NULLIF(CONCAT_WS(' - ', NULLIF(a2.ubicacion, ''), NULLIF(c2.direccion, '')), ''), '; ')
                                      FROM detalle_ot d2 JOIN almacenes a2 ON a2.id_almacen = d2.id_almacen
                                      LEFT JOIN centros c2 ON c2.id_centro = a2.id_centro WHERE d2.id_remision = r.id_remision)
        WHEN 'TRANSFERENCIA' THEN NULLIF(CONCAT_WS(' - ', NULLIF(ao.ubicacion, ''), NULLIF(cao.direccion, '')), '')
        WHEN 'SALIDA_ACTIVOS' THEN (SELECT string_agg(DISTINCT c3.direccion, '; ') FROM solicitudes_activos_detalle d3
                                      JOIN centros c3 ON c3.id_centro = d3.id_centro_origen WHERE d3.id_solicitud = sa.id_solicitud)
        ELSE NULL END AS partida_direccion,
    CASE r.tipo_remision
        WHEN 'SALIDA_INSUMOS' THEN COALESCE(c.nombre, '') || ' / ' || COALESCE(cc.codigo || ' - ' || cc.descripcion, cc.codigo, '')
        WHEN 'TRANSFERENCIA' THEN ad.nombre || ' (' || COALESCE(cad.nombre, '') || ')'
        WHEN 'SALIDA_ACTIVOS' THEN CASE WHEN sa.tipo = 'REPARACION' THEN 'Proveedor: ' || COALESCE(pv.razon_social, '') || COALESCE(' (RUC ' || pv.ruc || ')', '')
                                        ELSE COALESCE(csa.nombre, '') || ' / ' || COALESCE(ccsa.codigo || ' - ' || ccsa.descripcion, ccsa.codigo, '') END
        ELSE '' END AS llegada,
    CASE r.tipo_remision
        WHEN 'SALIDA_INSUMOS' THEN c.direccion
        WHEN 'TRANSFERENCIA' THEN NULLIF(CONCAT_WS(' - ', NULLIF(ad.ubicacion, ''), NULLIF(cad.direccion, '')), '')
        WHEN 'SALIDA_ACTIVOS' THEN CASE WHEN sa.tipo = 'REPARACION' THEN pv.direccion ELSE csa.direccion END
        ELSE NULL END AS llegada_direccion,
    cp.copia, cp.ejemplar, cp.para_quien,
    l.codigo, l.descripcion, l.unidad, l.cantidad, l.almacen
FROM remisiones r
LEFT JOIN usuarios ue       ON ue.id_usuario = r.id_usuario_emite
LEFT JOIN ot o              ON o.id_ot = r.id_ot
LEFT JOIN centros c         ON c.id_centro = o.id_centro
LEFT JOIN centros_costo cc  ON cc.id_centro_costo = o.id_centro_costo
LEFT JOIN usuarios us       ON us.id_usuario = o.id_usuario_solic
LEFT JOIN transferencias t  ON t.id_transferencia = r.id_transferencia
LEFT JOIN almacenes ao      ON ao.id_almacen = t.id_almacen_origen
LEFT JOIN almacenes ad      ON ad.id_almacen = t.id_almacen_destino
LEFT JOIN centros cao       ON cao.id_centro = ao.id_centro
LEFT JOIN centros cad       ON cad.id_centro = ad.id_centro
LEFT JOIN solicitudes_activos sa ON sa.id_solicitud = r.id_solicitud_activo
LEFT JOIN proveedores pv    ON pv.id_proveedor = sa.id_proveedor
LEFT JOIN centros csa       ON csa.id_centro = sa.id_centro_destino
LEFT JOIN centros_costo ccsa ON ccsa.id_centro_costo = sa.id_centro_costo_destino
LEFT JOIN (
    SELECT rd.id_remision, rd.codigo, rd.descripcion, rd.unidad, rd.cantidad, rd.origen AS almacen, rd.orden
      FROM remisiones_detalle rd
) l ON l.id_remision = r.id_remision
CROSS JOIN (VALUES (1, 'ORIGINAL', 'Destinatario de las mercaderías'),
                   (2, 'DUPLICADO', 'Remitente de las mercaderías'),
                   (3, 'TRIPLICADO', 'Administración Tributaria'),
                   (4, 'CUADRUPLICADO', 'Transportista')) AS cp(copia, ejemplar, para_quien)
WHERE r.id_remision = $P{ID_REMISION}
ORDER BY cp.copia, l.orden]]>
	</queryString>
