<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports      http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="unidades_listado" pageWidth="842" pageHeight="595" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" orientation="Landscape">
    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="FECHA" class="java.util.Date"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <queryString>
        <![CDATA[
            SELECT id_unidad_medida, nombre, abreviatura, activo
            FROM unidad_medida
            ORDER BY id_unidad_medida
        ]]>
    </queryString>
    <field name="id_unidad_medida" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="abreviatura" class="java.lang.String"/>
    <field name="activo" class="java.lang.Boolean"/>
    <title>
        <band height="104">
            <image scaleImage="RetainShape" onErrorType="Blank">
                <reportElement x="0" y="0" width="42" height="42"/>
                <imageExpression><![CDATA[new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode(""))]]></imageExpression>
            </image>
            <!-- Banner del sistema -->
            <staticText>
                <reportElement x="52" y="1" width="220" height="27" forecolor="#1B4D2E"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Ñanday SIAA]]></text>
            </staticText>
            <staticText>
                <reportElement x="52" y="28" width="220" height="13" forecolor="#5F6B66"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Sistema Integrado de Administración de Almacenes]]></text>
            </staticText>
            <!-- Título del reporte -->
            <staticText>
                <reportElement x="0" y="54" width="802" height="22" forecolor="#1F4E79"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[LISTADO DE UNIDADES DE MEDIDA]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="79" width="802" height="1" forecolor="#1B4D2E"/>
            </line>
            <textField>
                <reportElement x="0" y="84" width="400" height="14" forecolor="#5F6B66"/>
                <textElement textAlignment="Left">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado por: " + $P{USUARIO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="402" y="84" width="400" height="14" forecolor="#5F6B66"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($P{FECHA})]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement x="0" y="44" width="802" height="3" mode="Opaque" forecolor="#1B4D2E" backcolor="#1B4D2E"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <rectangle>
                <reportElement x="0" y="44" width="90" height="3" mode="Opaque" forecolor="#C2410C" backcolor="#C2410C"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
        </band>
    </title>
    <columnHeader>
        <band height="28">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="28" mode="Opaque" backcolor="#1F4E79" forecolor="#1F4E79"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="0" y="4" width="50" height="20" forecolor="#FFFFFF"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="4" width="250" height="20" forecolor="#FFFFFF"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="4" width="200" height="20" forecolor="#FFFFFF"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Abreviatura]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="4" width="302" height="20" forecolor="#FFFFFF"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Activo]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="24">
            <!-- Banda cebra (filas pares) -->
            <rectangle>
                <reportElement x="0" y="0" width="802" height="24" mode="Opaque" backcolor="#F1F5FA" forecolor="#F1F5FA">
                    <printWhenExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() % 2 == 0)]]></printWhenExpression>
                </reportElement>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <line>
                <reportElement x="0" y="23" width="802" height="1" forecolor="#D5DED7"/>
            </line>
            <textField>
                <reportElement x="8" y="2" width="42" height="20" forecolor="#263238"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{id_unidad_medida}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="2" width="250" height="20" forecolor="#263238"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="2" width="200" height="20" forecolor="#263238"/>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{abreviatura}]]></textFieldExpression>
            </textField>
            <!-- Estado con bullet y color -->
            <textField>
                <reportElement x="500" y="2" width="302" height="20" forecolor="#2E7D32">
                    <printWhenExpression><![CDATA[$F{activo}]]></printWhenExpression>
                </reportElement>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Sí"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="500" y="2" width="302" height="20" forecolor="#B91C1C">
                    <printWhenExpression><![CDATA[!$F{activo}]]></printWhenExpression>
                </reportElement>
                <box leftPadding="3" rightPadding="3"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["No"]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <pageFooter>
        <band height="25">
            <line>
                <reportElement x="0" y="0" width="802" height="1" forecolor="#C9D3CC"/>
            </line>
            <textField>
                <reportElement x="0" y="5" width="672" height="14" forecolor="#7A8680"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Ñanday SIAA  •  Sistema Integrado de Administración de Almacenes"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="672" y="5" width="100" height="14" forecolor="#7A8680"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="772" y="5" width="30" height="14" forecolor="#7A8680"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    <summary>
        <band height="36">
            <rectangle radius="4">
                <reportElement x="0" y="4" width="802" height="26" mode="Opaque" backcolor="#E8F2EA" forecolor="#B9D7BF"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#B9D7BF"/>
                </graphicElement>
            </rectangle>
            <textField>
                <reportElement x="0" y="4" width="802" height="26" forecolor="#1B4D2E"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total de unidades: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
