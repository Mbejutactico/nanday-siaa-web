    <field name="item_subtotal" class="java.math.BigDecimal"/>
    <variable name="TOTAL_OC" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{item_subtotal}]]></variableExpression>
    </variable>
