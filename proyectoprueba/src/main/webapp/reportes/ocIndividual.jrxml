<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ocIndividual" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9b3c7d2a-1e4f-4a2b-8c3d-6f0a1b2c3d4e">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="ID_OC" class="java.lang.Integer"/>
    <parameter name="TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Orden de Compra"]]></defaultValueExpression>
    </parameter>
    <parameter name="FECHA" class="java.util.Date"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <parameter name="parameter1" class="java.lang.String"/>
    <queryString>
		<![CDATA[SELECT
    c.id_compra,
    c.numero_oc,
    c.fecha_compra,
    c.estado,
    c.observaciones,
    p.razon_social  AS proveedor_razon_social,
    p.ruc           AS proveedor_ruc,
    p.direccion     AS proveedor_direccion,
    p.telefono      AS proveedor_telefono,
    p.email         AS proveedor_email,
    cen.nombre      AS centro_destino,
    (u.nombre || ' ' || u.apellido) AS solicitante,
    i.codigo        AS item_codigo,
    i.descripcion   AS item_descripcion,
    d.cantidad      AS item_cantidad,
    COALESCE(d.cantidad_recibida, 0) AS item_cantidad_recibida,
    (d.cantidad - COALESCE(d.cantidad_recibida, 0)) AS item_pendiente,
    d.precio_unitario AS item_precio_unitario,
    CASE
        WHEN c.estado = 'PARCIAL' THEN (d.cantidad - COALESCE(d.cantidad_recibida, 0)) * d.precio_unitario
        ELSE d.cantidad * d.precio_unitario
    END AS item_subtotal
FROM compras c
LEFT JOIN proveedores p   ON c.id_proveedor = p.id_proveedor
LEFT JOIN centros cen     ON c.id_centro_destino = cen.id_centro
LEFT JOIN usuarios u      ON c.id_usuario_solicitante = u.id_usuario
LEFT JOIN detalle_compra d ON c.id_compra = d.id_compra AND d.tipo_item = 'INSUMO'
LEFT JOIN insumos i       ON d.id_insumo = i.id_insumo
WHERE c.id_compra = $P{ID_OC}
ORDER BY i.descripcion]]>
	</queryString>
