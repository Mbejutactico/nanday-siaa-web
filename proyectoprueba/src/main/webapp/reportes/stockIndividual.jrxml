    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="ID_STOCK" class="java.lang.Integer"/>
    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="FECHA" class="java.util.Date"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <queryString>
		<![CDATA[SELECT s.id_stock, i.codigo AS insumo_codigo, i.descripcion AS insumo_desc,
                   a.nombre AS almacen_nombre, s.stock_actual, s.stock_minimo
            FROM stock_almacen s
            INNER JOIN insumos i ON s.id_insumo = i.id_insumo
            INNER JOIN almacenes a ON s.id_almacen = a.id_almacen
            WHERE s.id_stock = $P{ID_STOCK}]]>
	</queryString>
    <field name="id_stock" class="java.lang.Integer"/>
    <field name="insumo_codigo" class="java.lang.String"/>
    <field name="insumo_desc" class="java.lang.String"/>
    <field name="almacen_nombre" class="java.lang.String"/>
    <field name="stock_actual" class="java.lang.Integer"/>
    <field name="stock_minimo" class="java.lang.Integer"/>
