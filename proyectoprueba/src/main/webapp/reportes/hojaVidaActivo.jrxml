    <field name="numero_movimiento_unico" class="java.lang.String"/>
    <field name="tipo_texto" class="java.lang.String"/>
    <field name="origen" class="java.lang.String"/>
    <field name="destino" class="java.lang.String"/>
    <field name="detalle" class="java.lang.String"/>
    <variable name="CANT_MOV" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{id_movimiento}]]></variableExpression>
    </variable>
