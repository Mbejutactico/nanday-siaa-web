<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="hojaVidaActivo" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e5fad754-8f8b-41ea-bacb-a2ab9a58a807">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="ID_EQUIPO" class="java.lang.Integer"/>
    <parameter name="TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Hoja de vida del activo"]]></defaultValueExpression>
    </parameter>
    <parameter name="FECHA" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <parameter name="USUARIO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
    </parameter>
    <queryString>
		<![CDATA[SELECT
    e.id_equipo,
    e.serial_activo,
    COALESCE(e.numero_serie, '-')             AS numero_serie,
    e.estado,
    CASE e.estado
        WHEN 'DISPONIBLE' THEN 'Disponible'
        WHEN 'ASIGNADO' THEN 'Asignado'
        WHEN 'EN_TRANSITO' THEN 'En tránsito'
        WHEN 'EN_REPARACION' THEN 'En reparación'
        WHEN 'BAJA' THEN 'De baja'
        WHEN 'SOLICITADO' THEN 'Pedido (por recibir)'
        WHEN 'ANULADO' THEN 'Anulado'
        ELSE e.estado END                     AS estado_texto,
    e.fecha_ingreso,
    i.codigo,
    i.descripcion,
    ce.nombre                                 AS centro_actual,
    CASE WHEN cc.codigo IS NULL THEN 'Sin asignar'
         WHEN COALESCE(TRIM(cc.descripcion), '') = '' THEN cc.codigo
         ELSE cc.codigo || ' - ' || cc.descripcion END AS centro_costo_actual,
    (SELECT COALESCE(ur.nombre || ' ' || ur.apellido,
                     NULLIF(TRIM(COALESCE(ma.datos_receptor_nombre, '') || ' ' || COALESCE(ma.datos_receptor_apellido, '')), ''))
       FROM movimientos_activos ma
       LEFT JOIN usuarios ur ON ur.id_usuario = ma.id_usuario_receptor
      WHERE ma.id_equipo = e.id_equipo AND ma.tipo_movimiento = 'ASIGNACION'
      ORDER BY ma.fecha_movimiento DESC, ma.id_movimiento DESC
      LIMIT 1)                                AS responsable,
    c.numero_oc,
    c.fecha_compra,
    p.razon_social                            AS proveedor,
    p.ruc                                     AS proveedor_ruc,
    (us.nombre || ' ' || us.apellido)         AS solicitante,
    d.precio_unitario                         AS valor_compra,
    m.id_movimiento,
    m.fecha_movimiento,
    m.numero_movimiento_unico,
    CASE m.tipo_movimiento
        WHEN 'INGRESO' THEN 'Ingreso por compra'
        WHEN 'ENVIO' THEN 'Envío'
        WHEN 'RECEPCION' THEN 'Recepción'
        WHEN 'RECHAZO' THEN 'Rechazo de envío'
        WHEN 'ASIGNACION' THEN 'Asignación'
        WHEN 'DEVOLUCION' THEN 'Devolución'
        WHEN 'REPARACION' THEN 'Envío a reparación'
        WHEN 'RETORNO_REPARACION' THEN 'Retorno de reparación'
        WHEN 'BAJA' THEN 'Baja'
        WHEN 'REUBICACION' THEN 'Cambio de centro de costo'
        WHEN 'ANULACION_SALIDA' THEN 'Anulación de salida'
        ELSE m.tipo_movimiento END            AS tipo_texto,
    CONCAT_WS(' / ', co.nombre, COALESCE(cco.codigo, ao.nombre)) AS origen,
    CONCAT_WS(' / ', cd.nombre, COALESCE(ccd.codigo, ad.nombre)) AS destino,
    CONCAT_WS('  |  ',
        'Registró: ' || (ug.nombre || ' ' || ug.apellido),
        CASE WHEN ue.id_usuario IS NOT NULL AND m.tipo_movimiento <> 'INGRESO' THEN 'Envía: ' || ue.nombre || ' ' || ue.apellido END,
        CASE WHEN ur2.id_usuario IS NOT NULL THEN
             (CASE WHEN m.tipo_movimiento = 'ASIGNACION' THEN 'Responsable: ' ELSE 'Recibe: ' END) || ur2.nombre || ' ' || ur2.apellido END,
        CASE WHEN m.datos_receptor_nombre IS NOT NULL THEN
             (CASE m.tipo_movimiento WHEN 'ENVIO' THEN 'Traslada: ' WHEN 'REPARACION' THEN 'Técnico: ' WHEN 'ASIGNACION' THEN 'Responsable: ' ELSE 'Persona: ' END)
             || TRIM(m.datos_receptor_nombre || ' ' || COALESCE(m.datos_receptor_apellido, ''))
             || COALESCE(' (CI ' || m.datos_receptor_ci || ')', '') END,
        CASE WHEN m.datos_receptor_vehiculo_chapa IS NOT NULL OR m.datos_receptor_vehiculo_marca IS NOT NULL THEN
             'Vehículo: ' || TRIM(COALESCE(m.datos_receptor_vehiculo_marca, '') || ' ' || COALESCE(m.datos_receptor_vehiculo_modelo, ''))
             || COALESCE(' - Chapa ' || m.datos_receptor_vehiculo_chapa, '') END,
        CASE WHEN r.numero_remision IS NOT NULL THEN 'Remisión N° ' || r.numero_remision END,
        CASE WHEN pv.razon_social IS NOT NULL THEN 'Proveedor / taller: ' || pv.razon_social END,
        CASE WHEN m.observaciones IS NOT NULL THEN 'Obs.: ' || m.observaciones END,
        CASE WHEN m.justificacion_rechazo IS NOT NULL THEN 'Motivo del rechazo: ' || m.justificacion_rechazo END
    )                                         AS detalle
FROM equipos e
LEFT JOIN insumos i         ON i.id_insumo = e.id_insumo_base
LEFT JOIN centros ce        ON ce.id_centro = e.id_centro_actual
LEFT JOIN centros_costo cc  ON cc.id_centro_costo = e.id_centro_costo_actual
LEFT JOIN detalle_compra d  ON d.id_equipo = e.id_equipo
LEFT JOIN compras c         ON c.id_compra = d.id_compra
LEFT JOIN proveedores p     ON p.id_proveedor = c.id_proveedor
LEFT JOIN usuarios us       ON us.id_usuario = c.id_usuario_solicitante
LEFT JOIN movimientos_activos m ON m.id_equipo = e.id_equipo
LEFT JOIN centros co        ON co.id_centro = m.id_centro_origen
LEFT JOIN centros cd        ON cd.id_centro = m.id_centro_destino
LEFT JOIN centros_costo cco ON cco.id_centro_costo = m.id_centro_costo_origen
LEFT JOIN centros_costo ccd ON ccd.id_centro_costo = m.id_centro_costo_destino
LEFT JOIN almacenes ao      ON ao.id_almacen = m.id_almacen_origen
LEFT JOIN almacenes ad      ON ad.id_almacen = m.id_almacen_destino
LEFT JOIN usuarios ug       ON ug.id_usuario = m.id_usuario_registro
LEFT JOIN usuarios ue       ON ue.id_usuario = m.id_usuario_emisor
LEFT JOIN usuarios ur2      ON ur2.id_usuario = m.id_usuario_receptor
LEFT JOIN remisiones r      ON r.id_remision = m.id_remision
LEFT JOIN solicitudes_activos sa ON sa.id_solicitud = r.id_solicitud_activo AND m.tipo_movimiento = 'REPARACION'
LEFT JOIN proveedores pv    ON pv.id_proveedor = sa.id_proveedor
WHERE e.id_equipo = $P{ID_EQUIPO}
ORDER BY m.fecha_movimiento ASC NULLS LAST, m.id_movimiento ASC]]>
	</queryString>
