<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="kardex" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="0ba4d8e3-e8cc-4c5d-9ceb-466423ca61b1">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="ID_INSUMO" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[Integer.valueOf(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="ID_ALMACEN" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[Integer.valueOf(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="DESDE" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="HASTA" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="CENTROS" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="USUARIO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
    </parameter>
    <parameter name="FECHA" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <queryString>
		<![CDATA[SELECT
    m.fecha,
    CASE m.tipo
        WHEN 'SALDO_INICIAL' THEN 'Saldo inicial'
        WHEN 'ENTRADA_COMPRA' THEN 'Entrada por compra'
        WHEN 'SALIDA_OT' THEN 'Salida por OT'
        WHEN 'DEVOLUCION_OT' THEN 'Devolución de OT'
        WHEN 'AJUSTE' THEN 'Ajuste'
        WHEN 'ANULACION_AJUSTE' THEN 'Anulación de ajuste'
        WHEN 'TRANSFERENCIA_SALIDA' THEN 'Transferencia (sale)'
        WHEN 'TRANSFERENCIA_ENTRADA' THEN 'Transferencia (entra)'
        WHEN 'ANULACION_TRANSFERENCIA' THEN 'Anulación de transferencia'
        ELSE m.tipo END AS tipo,
    m.documento,
    a.nombre AS almacen,
    CASE WHEN m.cantidad > 0 THEN m.cantidad END AS entrada,
    CASE WHEN m.cantidad < 0 THEN -m.cantidad END AS salida,
    m.saldo,
    u.nombre || ' ' || u.apellido AS usuario,
    m.observacion,
    i.codigo || ' - ' || i.descripcion AS insumo
FROM movimientos_stock m
JOIN insumos i   ON i.id_insumo = m.id_insumo
JOIN almacenes a ON a.id_almacen = m.id_almacen
LEFT JOIN usuarios u ON u.id_usuario = m.id_usuario
WHERE m.id_insumo = $P{ID_INSUMO}
  AND ($P{ID_ALMACEN} = 0 OR m.id_almacen = $P{ID_ALMACEN})
  AND ($P{CENTROS} = '' OR a.id_centro = ANY (string_to_array($P{CENTROS}, ',')::integer[]))
  AND m.fecha >= COALESCE(CAST(NULLIF($P{DESDE}, '') AS date), '-infinity'::date)
  AND m.fecha <  COALESCE(CAST(NULLIF($P{HASTA}, '') AS date) + 1, 'infinity'::date)
ORDER BY m.fecha, m.id_mov]]>
	</queryString>
    <field name="fecha" class="java.sql.Timestamp"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="documento" class="java.lang.String"/>
    <field name="almacen" class="java.lang.String"/>
    <field name="entrada" class="java.lang.Integer"/>
    <field name="salida" class="java.lang.Integer"/>
    <field name="saldo" class="java.lang.Integer"/>
    <field name="usuario" class="java.lang.String"/>
    <field name="observacion" class="java.lang.String"/>
    <field name="insumo" class="java.lang.String"/>
    <variable name="TOT_ENTRADAS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{entrada}]]></variableExpression>
    </variable>
    <variable name="TOT_SALIDAS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{salida}]]></variableExpression>
    </variable>
