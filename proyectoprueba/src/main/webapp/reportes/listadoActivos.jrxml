<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="listadoActivos" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9eacec6e-c51c-41f2-b3af-8a3f91183bf0">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="TITULO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Listado de Activos Fijos"]]></defaultValueExpression>
    </parameter>
    <parameter name="FECHA" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <parameter name="USUARIO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
    </parameter>
    <parameter name="ID_CENTRO" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[Integer.valueOf(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="ID_CENTRO_COSTO" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[Integer.valueOf(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="ESTADO" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="PENDIENTES" class="java.lang.Boolean">
        <defaultValueExpression><![CDATA[Boolean.FALSE]]></defaultValueExpression>
    </parameter>
    <parameter name="CENTROS" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <queryString>
		<![CDATA[SELECT
    e.serial_activo                              AS numero_activo,
    i.codigo,
    i.descripcion,
    COALESCE(e.numero_serie, '-')                AS numero_serie,
    ce.nombre                                    AS centro,
    CASE WHEN cc.codigo IS NULL THEN 'Sin asignar'
         WHEN COALESCE(TRIM(cc.descripcion), '') = '' THEN cc.codigo
         ELSE cc.codigo || ' - ' || cc.descripcion END AS centro_costo,
    CASE e.estado
        WHEN 'DISPONIBLE' THEN 'Disponible'
        WHEN 'ASIGNADO' THEN 'Asignado'
        WHEN 'EN_TRANSITO' THEN 'En tránsito'
        WHEN 'EN_REPARACION' THEN 'En reparación'
        WHEN 'BAJA' THEN 'De baja'
        WHEN 'SOLICITADO' THEN 'Pedido'
        WHEN 'ANULADO' THEN 'Anulado'
        ELSE e.estado END                        AS estado,
    CASE WHEN e.estado = 'ASIGNADO' THEN
        (SELECT COALESCE(ur.nombre || ' ' || ur.apellido,
                         NULLIF(TRIM(COALESCE(ma.datos_receptor_nombre, '') || ' ' || COALESCE(ma.datos_receptor_apellido, '')), ''))
           FROM movimientos_activos ma
           LEFT JOIN usuarios ur ON ur.id_usuario = ma.id_usuario_receptor
          WHERE ma.id_equipo = e.id_equipo AND ma.tipo_movimiento = 'ASIGNACION'
          ORDER BY ma.fecha_movimiento DESC, ma.id_movimiento DESC
          LIMIT 1)
    END                                          AS responsable
FROM equipos e
LEFT JOIN insumos i        ON i.id_insumo = e.id_insumo_base
LEFT JOIN centros ce       ON ce.id_centro = e.id_centro_actual
LEFT JOIN centros_costo cc ON cc.id_centro_costo = e.id_centro_costo_actual
WHERE ($P{ESTADO} = '' OR e.estado = $P{ESTADO})
  AND ($P{ID_CENTRO} = 0 OR e.id_centro_actual = $P{ID_CENTRO})
  AND ($P{CENTROS} = '' OR e.id_centro_actual = ANY (string_to_array($P{CENTROS}, ',')::integer[]))
  AND ($P{ID_CENTRO_COSTO} = 0 OR e.id_centro_costo_actual = $P{ID_CENTRO_COSTO})
  AND ($P{PENDIENTES} OR e.estado NOT IN ('SOLICITADO', 'ANULADO'))
ORDER BY ce.nombre, cc.codigo, e.serial_activo]]>
	</queryString>
    <field name="numero_activo" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="numero_serie" class="java.lang.String"/>
    <field name="centro" class="java.lang.String"/>
    <field name="centro_costo" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <field name="responsable" class="java.lang.String"/>
