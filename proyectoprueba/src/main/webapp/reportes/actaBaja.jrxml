<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="actaBaja" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="762c0945-1d2e-44f5-a7bd-2760fd510894">
    <property name="ireport.zoom" value="1.0"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="ID_SOLICITUD" class="java.lang.Integer">
        <defaultValueExpression><![CDATA[Integer.valueOf(0)]]></defaultValueExpression>
    </parameter>
    <parameter name="USUARIO" class="java.lang.String">
        <defaultValueExpression><![CDATA["Sistema"]]></defaultValueExpression>
    </parameter>
    <parameter name="FECHA" class="java.util.Date">
        <defaultValueExpression><![CDATA[new java.util.Date()]]></defaultValueExpression>
    </parameter>
    <queryString>
		<![CDATA[SELECT
    s.numero, s.fecha, s.estado, s.observacion, s.fecha_resolucion, s.motivo_rechazo,
    CASE s.motivo_baja WHEN 'OBSOLESCENCIA' THEN 'Obsolescencia' WHEN 'ROTURA_IRREPARABLE' THEN 'Rotura irreparable'
         WHEN 'ROBO_PERDIDA' THEN 'Robo / pérdida' WHEN 'VENTA' THEN 'Venta' WHEN 'DONACION' THEN 'Donación' ELSE 'Otro' END AS motivo,
    us.nombre || ' ' || us.apellido AS solicitado_por,
    ur.nombre || ' ' || ur.apellido AS aprobado_por,
    e.serial_activo AS numero_activo, COALESCE(e.numero_serie, '-') AS numero_serie, i.codigo, i.descripcion,
    COALESCE(co.nombre, '') || COALESCE(' / ' || cco.codigo, '') AS ubicacion,
    (SELECT dc.precio_unitario FROM detalle_compra dc WHERE dc.id_equipo = e.id_equipo LIMIT 1) AS valor
FROM solicitudes_activos s
JOIN solicitudes_activos_detalle d ON d.id_solicitud = s.id_solicitud
JOIN equipos e ON e.id_equipo = d.id_equipo
LEFT JOIN insumos i ON i.id_insumo = e.id_insumo_base
LEFT JOIN centros co ON co.id_centro = d.id_centro_origen
LEFT JOIN centros_costo cco ON cco.id_centro_costo = d.id_centro_costo_origen
LEFT JOIN usuarios us ON us.id_usuario = s.id_usuario_solicita
LEFT JOIN usuarios ur ON ur.id_usuario = s.id_usuario_resuelve
WHERE s.id_solicitud = $P{ID_SOLICITUD} AND s.tipo = 'BAJA'
ORDER BY d.id_detalle]]>
	</queryString>
