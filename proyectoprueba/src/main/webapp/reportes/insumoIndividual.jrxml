    <queryString>
		<![CDATA[SELECT i.id_insumo, i.codigo, i.descripcion, 
                   u.nombre AS unidad_nombre, i.precio_compra, i.activo
            FROM insumos i
            LEFT JOIN unidad_medida u ON i.id_unidad_medida = u.id_unidad_medida
            WHERE i.id_insumo = $P{ID_INSUMO}]]>
	</queryString>
